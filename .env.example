# Copy to .env and fill in only what you use. Never commit .env.
#
# Global cost rule. Leave it as FREE_ONLY. Any other or invalid value that is
# not exactly ALLOW_PAID also means FREE_ONLY.
COST_MODE=FREE_ONLY

# Free plan, no payment method: https://console.groq.com/keys
GROQ_API_KEY=

# Free models only, never buy credits: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
